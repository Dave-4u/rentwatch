# Backend (optional — defaults work for local demo)
SECRET_KEY=rentwatch-dev-secret-change-in-production
DATABASE_URL=sqlite:///./data/rentwatch.db
# Comma-separated origins, or * for any (credentials disabled when *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://dave-4u.github.io

# Frontend (leave empty for Vite proxy / same-origin FastAPI)
# For GitHub Pages build, set to Render API origin, e.g. https://rentwatch.onrender.com
VITE_API_URL=

# Example production SECRET_KEY (generate your own):
# SECRET_KEY=16852d8d6bfc406281d5c624e6d8c9a343efae31a9ba560390f59efcd0c21132
